<apex:page standardController="VRT_Rental__c" renderAs="pdf" applyBodyTag="false" showHeader="false" sidebar="false">
    <head>
        <style>
            body { font-family: 'Arial', sans-serif; font-size: 14px; color: #333; }
            .header { text-align: center; border-bottom: 2px solid #005fb2; padding-bottom: 10px; margin-bottom: 30px; }
            .title { font-size: 24px; color: #005fb2; font-weight: bold; }
            .section { margin-bottom: 20px; }
            table { width: 100%; border-collapse: collapse; margin-top: 15px; }
            th { background-color: #005fb2; color: white; padding: 8px; text-align: left; }
            td { padding: 8px; border-bottom: 1px solid #ddd; }
            .total { font-size: 16px; font-weight: bold; text-align: right; margin-top: 20px; }
            .descuento { font-size: 14px; font-weight: bold; text-align: right; margin-top: 20px; }
        </style>
    </head>
    <body>
        <div class="header">
            <div class="title">FACTURA DE ALQUILER</div>
            <div>Rental ID: {!VRT_Rental__c.Name}</div>
        </div>

        <div class="section">
            <p><strong>Fecha de Factura: </strong> <apex:outputText value="{0,date,dd/MM/yyyy}"><apex:param value="{!TODAY()}" /></apex:outputText></p>
            <!-- Cambia 'Cliente__r.Name' por el nombre de tu campo de relación con el cliente -->
            <p><strong>Cliente: </strong> {!VRT_Rental__c.VRT_LKP_Account__r.Name}</p>
            <p><strong>ID Cliente: </strong> {!VRT_Rental__c.VRT_LKP_Account__c}</p> 
            <p><strong>Estado del Alquiler: </strong> {!VRT_Rental__c.VRT_SEL_Status__c}</p>
            <p><strong>Fecha de Inicio: </strong> <apex:outputText value="{0,date,dd/MM/yyyy}"><apex:param value="{!VRT_Rental__c.VRT_DAT_InitialDate__c}" /></apex:outputText></p>
            <p><strong>Fecha de Finalización: </strong> <apex:outputText value="{0,date,dd/MM/yyyy}"><apex:param value="{!VRT_Rental__c.VRT_DAT_FinalDate__c}" /></apex:outputText></p>
            <p><strong>Vehiculo: </strong> {!VRT_Rental__c.VRT_LKP_Vehicle__r.Name}</p>
        </div>

        <table>
            <thead>
                <tr>
                    <th>Concepto</th>
                    <th>Detalle</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Coste del alquiler</td>
                    <td>
                        <apex:outputText value="{0, number, #,##0.00}">
                            <apex:param value="{!VRT_Rental__c.VRT_DIV_TotalCost__c - VRT_Rental__c.VRT_DIV_penalty__c}" />
                        </apex:outputText> €
                    </td>  
                </tr>
                <tr>
                    <td>Penalización</td>
                    <td>
                        <apex:outputText value="{0, number, #,##0.00}">
                            <apex:param value="{!VRT_Rental__c.VRT_DIV_penalty__c}" />
                        </apex:outputText> €
                    </td>  
                </tr>
            </tbody>
        </table>

        
        <div class="total">
            Coste final: 
            <apex:outputText value="{0, number, #,##0.00}">
                <apex:param value="{!VRT_Rental__c.VRT_DIV_TotalCost__c}" />
            </apex:outputText> €
        </div>
        
    </body>
</apex:page>